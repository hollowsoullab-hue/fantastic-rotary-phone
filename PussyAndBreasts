local Players = game:GetService("Players")
local player = Players.LocalPlayer

local REF_CFRAME = CFrame.new(291.30010986328125, 358.79998779296875, 480.74969482421875, 0.9999034404754639, -0, -0.013897508382797241, 0, 1, -0, 0.013897508382797241, 0, 0.9999034404754639)

local function getRelativeCFrame(worldCFrame)
    return REF_CFRAME:ToObjectSpace(worldCFrame)
end

local function StripClothingOnly(char)
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Clothing") or child:IsA("ShirtGraphic") then
            child:Destroy()
        elseif child:IsA("Model") then
            local name = child.Name:lower()
            if name:find("clothing") or name:find("jacket") or name:find("pants") or name:find("shirt") or name:find("sweater") or name:find("dress") then
                child:Destroy()
            end
        end
    end
end

