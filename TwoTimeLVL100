-- ===== LIFE2 VFX ENHANCEMENT =====
local function enableLife2VFX(character)
    if not character then return end
    
    print("🔥 Enabling Life2 VFX...")
    
    -- Find the config
    local legacyMS4 = replicatedStorage:FindFirstChild("Assets")
    if legacyMS4 then legacyMS4 = legacyMS4:FindFirstChild("Skins") end
    if legacyMS4 then legacyMS4 = legacyMS4:FindFirstChild("Survivors") end
    if legacyMS4 then legacyMS4 = legacyMS4:FindFirstChild("TwoTime") end
    if legacyMS4 then legacyMS4 = legacyMS4:FindFirstChild("LegacyMS100TwoTime") end
    
    if not legacyMS4 then return end
    
    local config = legacyMS4:FindFirstChild("Config")
    if not config then return end
    
    -- Find or create Respawned folder
    local respawned = character:FindFirstChild("Respawned")
    if not respawned then
        respawned = Instance.new("Folder")
        respawned.Name = "Respawned"
        respawned.Parent = character
    end
    
    -- Copy RespawnVFX from config
    local respawnVFX = config:FindFirstChild("RespawnVFX")
    if respawnVFX and respawnVFX:IsA("ParticleEmitter") then
        local newVFX = respawnVFX:Clone()
        newVFX.Enabled = true
        newVFX.Parent = respawned
        print("✅ RespawnVFX enabled")
    end
    
    -- Copy GhostFire from config
    local ghostFire = config:FindFirstChild("GhostFire")
    if ghostFire and ghostFire:IsA("Model") then
        local existingGhostFire = character:FindFirstChild("GhostFire")
        if existingGhostFire then
            existingGhostFire:Destroy()
        end
        
        local newGhostFire = ghostFire:Clone()
        newGhostFire.Parent = character
        print("✅ GhostFire enabled")
    end
    
    -- Copy TwoTimeVFX from config
    local twoTimeVFX = config:FindFirstChild("TwoTimeVFX")
    if twoTimeVFX and twoTimeVFX:IsA("Part") then
        local newVFXPart = twoTimeVFX:Clone()
        newVFXPart.Parent = character
        print("✅ TwoTimeVFX enabled")
    end
    
    -- Enable all particle emitters in Respawned
    for _, child in ipairs(respawned:GetChildren()) do
        if child:IsA("ParticleEmitter") then
            child.Enabled = true
            print("✅ Enabled particle: " .. child.Name)
        end
    end
end

