-- ===== MONITOR LIFE STATE =====
local function monitorLifeState(character)
    if not character then return end
    
    character.AttributeChanged:Connect(function(attributeName)
        if attributeName == "IsSecondLife" and character:GetAttribute("IsSecondLife") == true then
            print("✨ Detected Life 2 via Attribute! Switching skin to Life2...")
            hasUsedLife2 = true
            task.wait(0.1)
            applySkinInstant()
            changeTwoTimeIcon()
        end
    end)
    
    character.ChildAdded:Connect(function(child)
        if child.Name == "Life2" then
            print("✨ Detected Life 2 Model! Switching skin to Life2...")
            hasUsedLife2 = true
            task.wait(0.1)
            applySkinInstant()
            changeTwoTimeIcon()
        end
    end)
end

